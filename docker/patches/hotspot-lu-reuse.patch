+/* OpenTSense (G94, patch hotspot-lu-reuse): the LU factors of A = C/h + G are kept between calls and reused while
+ * G, C and h are the same (dgstrs), instead of a full dgssv factorisation every step. dgssv factorises and then
+ * solves with dgstrs itself, so each step's arithmetic is unchanged. Also frees the right-hand side's values,
+ * which leaked one n-vector per step. */
+static SuperMatrix be_L, be_U;
+static int *be_perm_r = NULL, *be_perm_c = NULL;
+static SuperMatrix *be_G = NULL;
+static diagonal_matrix_t *be_C = NULL;
+static double be_h = -1.0;
+
+/* Free the cached factors (called before another large solve, so two factorisations are never held at once). */
+void backward_euler_release(void)
+{
+  if(be_perm_r == NULL)
+    return;
+  SUPERLU_FREE (be_perm_r);
+  SUPERLU_FREE (be_perm_c);
+  Destroy_SuperNode_Matrix(&be_L);
+  Destroy_CompCol_Matrix(&be_U);
+  be_perm_r = be_perm_c = NULL;
+  be_G = NULL;
+  be_C = NULL;
+}
